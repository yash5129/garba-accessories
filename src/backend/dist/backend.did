type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ProductId = text;
type ProductDetails = 
 record {
   category: Category;
   description: text;
   name: text;
 };
type Product = 
 record {
   available: bool;
   category: Category;
   createdAt: Timestamp;
   description: text;
   id: ProductId;
   imageKey: text;
   name: text;
   priceInPaise: opt PriceInPaise;
   sortOrder: nat;
 };
type PriceInPaise = nat;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type Category = 
 variant {
   beaniesAndHats;
   braidedAccessories;
   hairBows;
   hairClips;
   hairFlowers;
   hairstyleLooks;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  /// Static Markdown documentation of the public backend API.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Single product detail by id.
  getProduct: (id: ProductId) -> (opt Product) query;
  isCallerAdmin: () -> (bool) query;
  /// All products for the storefront.
  listProducts: () -> (vec Product) query;
  schema: () -> (text) query;
  /// Admin-only: ensure the initial product rows exist. Idempotent.
  seedProducts: () -> ();
  /// Admin-only: mark a product available or sold out.
  setProductAvailability: (id: ProductId, available: bool) -> ();
  /// Admin-only: replace a product's object-storage image key.
  setProductImage: (id: ProductId, imageKey: text) -> ();
  /// Admin-only: set or clear a product's price in paise.
  setProductPrice: (id: ProductId, priceInPaise: opt PriceInPaise) -> ();
  /// Admin-only: update name, category, and description.
  updateProductDetails: (id: ProductId, details: ProductDetails) -> ();
}
